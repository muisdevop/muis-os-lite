# Copy to .env and fill in. Never commit .env.
# Only NEBIUS_API_KEY is needed for chat; TAVILY_API_KEY adds web search + news in the brief.

# --- Nebius Token Factory (OpenAI-compatible) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# --- NVIDIA Nemotron open models (IDs from the Token Factory model catalog) ---
# Planning + tool-calling agent loop: Nemotron 3 Super
NEMOTRON_PLAN_MODEL=nvidia/nemotron-3-super-120b-a12b
# Fast calls (skill reflection, daily brief): Nemotron 3 Nano
NEMOTRON_FAST_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Optional JSON merged into every chat request, e.g. to turn reasoning off:
# LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
LLM_EXTRA_BODY=

# --- Any other OpenAI-compatible endpoint (optional, for testing) ---
# LLM_BASE_URL overrides NEBIUS_BASE_URL; LLM_API_KEY is used when NEBIUS_API_KEY is empty.
# Gemini example: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#                 NEMOTRON_PLAN_MODEL=gemini-2.5-flash NEMOTRON_FAST_MODEL=gemini-2.5-flash
#                 EMBEDDING_MODEL=gemini-embedding-001
LLM_BASE_URL=
LLM_API_KEY=

# --- Embeddings (Token Factory embedding model) ---
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# 0 = detect the vector size from the first embedding
EMBEDDING_DIM=0
# auto = provider embeddings when a key is set, else a local offline embedder
# remote | local to force one. Each embedder uses its own Qdrant collection.
EMBEDDING_PROVIDER=auto
# Optional separate endpoint/key just for embeddings
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# --- Tavily web search (agent tool + news in the daily brief) ---
TAVILY_API_KEY=

# --- Qdrant vector memory ---
# empty = embedded Qdrant on disk in DATA_DIR/qdrant; ":memory:" = RAM only.
# docker compose sets this to http://qdrant:6333 (falls back to RAM if unreachable).
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=muis_memory

# --- Storage ---
# SQLite (chats, briefs, topics) + embedded Qdrant live here. Default ~/.muis-os-lite
DATA_DIR=
# Skill playbooks folder (default: app/skills). Docker: /data/skills on the data volume.
SKILLS_DIR=

# --- Agent ---
MAX_AGENT_STEPS=6
AUTO_LEARN_SKILLS=true

# --- Daily brief ---
ENABLE_SCHEDULER=true
DAILY_BRIEF_TIME=08:00
TZ_NAME=Asia/Karachi
# Comma-separated news topics used until you follow topics in the UI
BRIEF_TOPICS=

# --- Optional Google (read-only Gmail summary + today's Calendar). See docs/GOOGLE.md ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Web UI ---
# Set to require a password for the UI and API (strongly recommended on a public server).
APP_PASSWORD=
