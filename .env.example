# Copy to .env and fill in. Never commit .env.

# --- Nebius Token Factory (OpenAI-compatible) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# --- NVIDIA Nemotron open models (IDs from the Token Factory model catalog) ---
# Fast calls (reflection, extraction): Nemotron 3 Nano
NEMOTRON_FAST_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Planning + tool-calling agent loop: Nemotron 3 Super
NEMOTRON_PLAN_MODEL=nvidia/nemotron-3-super-120b-a12b

# --- Embeddings (Token Factory embedding model) ---
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# 0 = detect the vector size from the first embedding
EMBEDDING_DIM=0

# --- Tavily web search ---
TAVILY_API_KEY=

# --- Qdrant vector memory ---
# ":memory:" = in-process (dev). docker-compose overrides this to http://qdrant:6333
QDRANT_URL=:memory:
QDRANT_API_KEY=
QDRANT_COLLECTION=muis_memory

# --- Agent ---
# Folder for skill playbooks (defaults to app/skills). In Docker, mount a volume here.
SKILLS_DIR=
MAX_AGENT_STEPS=6
AUTO_LEARN_SKILLS=true

# --- Daily brief (scheduler stub) ---
DAILY_BRIEF_TIME=08:00
TZ_NAME=Asia/Karachi
